      "source": [
        "# construct the argument parser and parse the arguments\n",
        "ap = argparse.ArgumentParser()\n",
        "ap.add_argument(\"-i\", \"--image\", required = True,\n",
        "\thelp = \"Path to the image to be scanned\")\n",
        "args = vars(ap.parse_args())"
      ]
    },
